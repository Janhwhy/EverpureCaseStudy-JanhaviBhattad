# Copy to .env (gitignored). Leave DATA_SOURCE unset to use the built-in DuckDB.
# DATA_SOURCE=snowflake

# Account identifier from Snowsight: Admin > Accounts, or the URL <orgname>-<account>.snowflakecomputing.com
SNOWFLAKE_ACCOUNT=<orgname>-<account_name>
SNOWFLAKE_USER=PI_SERVICE
# Path relative to the repo root. The private key never leaves your machine (.snowflake/ is gitignored).
SNOWFLAKE_PRIVATE_KEY_PATH=.snowflake/rsa_key.p8
SNOWFLAKE_ROLE=PI_APP
SNOWFLAKE_WAREHOUSE=PI_WH
SNOWFLAKE_DATABASE=PURE_INSIGHTS
