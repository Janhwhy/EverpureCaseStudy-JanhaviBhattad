{
  "name": "pure-insights-backend",
  "version": "1.0.0",
  "description": "Pure Insights Command Centre API",
  "scripts": {
    "test": "node --test",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start:snowflake": "DATA_SOURCE=snowflake node --env-file-if-exists=.env src/server.js",
    "test:snowflake": "DATA_SOURCE=snowflake node --env-file-if-exists=.env --test --test-concurrency=1 test/reconciliation.test.js test/api.test.js"
  },
  "type": "module",
  "dependencies": {
    "@duckdb/node-api": "^1.5.6-r.1",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "snowflake-sdk": "^3.4.0",
    "ws": "^8.22.0"
  }
}
